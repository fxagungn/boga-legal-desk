# --- wajib ---
DATABASE_URL=            # otomatis terisi saat Neon dihubungkan di Vercel
ACCESS_CODE=             # kode akses tim untuk login
AUTH_SECRET=             # string acak panjang untuk tanda tangan sesi
CRON_SECRET=             # Vercel mengirimkannya otomatis ke /api/cron/daily

# --- Sync tim Legal dari sheet karyawan Boga (Google) ---
# Service account JSON (atau base64-nya). Share sheet karyawan ke client_email-nya sebagai Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
EMPLOYEE_SHEET_ID=                 # ID spreadsheet karyawan (bagian di antara /d/ dan /edit pada URL)
# EMPLOYEE_SHEET_RANGE=EMPLOYEE!A:T
# EMPLOYEE_POSITION_PATTERN=\blegal\b|\bcplo\b   # regex Position Title
# EMPLOYEE_DEPT_PATTERN=\blegal\b                  # regex Dept/Outlet atau Div/Brand

# --- Outlook / Microsoft 365 (App Registration dari IT) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=legal@perusahaan.co.id   # shared mailbox yang dipantau
INTERNAL_DOMAINS=perusahaan.co.id   # balasan dari domain lain = pihak eksternal

# --- jalur masuk alternatif (Power Automate / forwarder) ---
INGEST_TOKEN=

# --- AI (default: Vercel AI Gateway via OIDC, tanpa key) ---
AI_MODEL=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=       # opsional: pakai API Anthropic langsung
# AI_DISABLED=true

# --- notifikasi ---
# RESEND_API_KEY=          # email bila tidak lewat Microsoft Graph
# RESEND_FROM="Legal Desk <legal@domain-anda.com>"
# FONNTE_TOKEN=            # WhatsApp via Fonnte
# WA_META_TOKEN=           # atau WhatsApp Cloud API (Meta)
# WA_META_PHONE_ID=
# WA_META_TEMPLATE=

# APP_URL=https://legal-desk.vercel.app
# SEED_DEMO=false
